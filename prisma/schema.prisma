generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model WorkerCategory {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  workers     HealthWorker[]
  alerts      Alert[] // Alerts targeted to this category
}

model HealthWorker {
  id          Int            @id @default(autoincrement())
  fullName    String
  phone       String         @unique
  email       String?
  location    String?
  isActive    Boolean        @default(true)
  language    String         @default("en") // en, hi, ta
  alertModes  String         // Stored as comma-separated: "SMS,Voice,App"
  categoryId  Int
  category    WorkerCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Alert {
  id          Int            @id @default(autoincrement())
  message     String
  type        String         // Emergency, Health, Disaster
  priority    String         // Low, Medium, High
  channels    String         // SMS,Voice,App
  targetCatId Int
  category    WorkerCategory @relation(fields: [targetCatId], references: [id])
  status      String         @default("SENT") // SENT, DELIVERED, ACKNOWLEDGED
  latitude    Float?
  longitude   Float?
  location    String?
  createdAt   DateTime       @default(now())
}

enum Role {
  ADMIN
  WORKER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  username  String   @unique
  password  String
  role      Role     @default(WORKER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
