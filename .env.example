# Database
DATABASE_URL="file:./dev.db" # Replace with your production DB URL (e.g. Postgres)

# Authentication (NextAuth.js)
AUTH_SECRET="your-super-secret-key-at-least-32-chars" # Generate with `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000" # Update for production

# SMTP Configuration (Email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"

# AI Configuration (Self-Hosted)
OLLAMA_HOST="http://localhost:11434" # URL to your Ollama instance
OLLAMA_MODEL="llama3"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
